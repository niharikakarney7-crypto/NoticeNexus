# NoticeNexus Environment Configuration Template
# Copy this file to .env and fill in your actual database credentials.

# Application Port (Unified server runs on this single port)
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password
DB_NAME=noticenexus

# JWT Secret for Session Authentication (replace with random 64-char string)
JWT_SECRET=noticenexus_super_secret_jwt_key_change_in_production
